        <TextEquiv conf="0.676">
          <Unicode>Ya no se trata de discutir las simpatías que puedan inspirar los líderes de una u otra nación.</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r000-l010" index="5" custom="heights_v2:[20.6,7.3]">
