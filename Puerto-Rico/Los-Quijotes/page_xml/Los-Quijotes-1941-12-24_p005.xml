        <TextEquiv conf="0.988">
          <Unicode>defensiva y ofensiva al lado de América entera: Norrée Centro y Sur.</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r000-l009" index="4" custom="heights_v2:[20.3,7.2]">
        <Coords points="1215,355 1096,357 981,357 866,357 750,357 635,357 520,357 404,357 289,357 170,357 170,384 289,384 404,384 520,384 635,384 750,384 866,384 981,384 1096,384 1215,382 1215,355" />
