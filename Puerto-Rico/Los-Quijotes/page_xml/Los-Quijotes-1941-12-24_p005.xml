        <TextEquiv conf="0.633">
          <Unicode>américa, por determinadas naciones europeas, los hombres de "Los Quijotes" toman posición</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r000-l008" index="3" custom="heights_v2:[20.5,6.9]">
        <Coords points="98,346 189,346 279,346 368,346 458,346 547,346 637,346 726,344 816,346 909,346 909,319 816,319 727,317 636,319 547,319 458,319 368,319 279,319 189,319 98,319 98,346" />
