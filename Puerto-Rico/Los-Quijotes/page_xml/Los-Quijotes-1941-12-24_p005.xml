        <TextEquiv conf="0.911">
          <Unicode>actitud asumida contra el democrático Gobierno y el Pueblo de los Estados Unidos de Norte América</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="r000-l007" index="2" custom="heights_v2:[20.2,6.9]">
        <Coords points="97,320 222,320 346,322 470,320 592,320 716,320 840,320 962,320 1086,320 1213,320 1213,293 1086,293 962,293 840,293 716,293 592,293 470,293 346,295 222,293 97,293 97,320" />
